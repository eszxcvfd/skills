#!/usr/bin/env python3
"""Generate isolated Codex homes for Paseo's supervisor/root/peer roles.

The checked-in project contract selects the provider and reasoning tuple. The
machine's existing ~/.codex/<role>.config.toml files remain the role-specific
instruction source; this command only projects them into isolated runtimes.
Credentials, skills, and plugins are shared explicitly through symlinks.
"""

from __future__ import annotations

import argparse
import configparser
import json
import os
from pathlib import Path
import re
import tempfile
import tomllib
from typing import Any


ROLES = ("supervisor", "root", "peer")
SHARED_ENTRIES = ("auth.json", "skills", "plugins")
TOP_LEVEL_ASSIGNMENT = re.compile(r"^(model|model_reasoning_effort|developer_instructions)\s*=")
CODEX_HOME_ASSIGNMENT = re.compile(r"^(\s*CODEX_HOME\s*=\s*)(?:\"[^\"]*\"|'[^']*')\s*$")


class SyncError(RuntimeError):
    pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Synchronize isolated Paseo Codex role runtimes",
    )
    repo_default = Path(__file__).resolve().parents[1]
    parser.add_argument("--repo-root", type=Path, default=repo_default)
    parser.add_argument("--codex-home", type=Path, default=Path.home() / ".codex")
    parser.add_argument("--runtime-root", type=Path, default=Path.home() / ".codex-runtime")
    return parser.parse_args()


def expand(path: Path) -> Path:
    return path.expanduser().resolve()


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError as error:
        raise SyncError(f"cannot read {path}: {error.strerror or error}") from error


def load_toml(path: Path) -> dict[str, Any]:
    try:
        with path.open("rb") as handle:
            value = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise SyncError(f"invalid TOML {path}: {error}") from error
    if not isinstance(value, dict):
        raise SyncError(f"TOML document is not an object: {path}")
    return value


def load_role_contract(repo_root: Path) -> dict[str, dict[str, str]]:
    path = repo_root / "config.model"
    parser = configparser.ConfigParser()
    try:
        with path.open(encoding="utf-8") as handle:
            parser.read_file(handle)
    except (OSError, configparser.Error) as error:
        raise SyncError(f"cannot read {path}: {error}") from error

    contract: dict[str, dict[str, str]] = {}
    for role in ROLES:
        if not parser.has_section(role):
            raise SyncError(f"{path}: missing [{role}] section")
        provider = parser.get(role, "provider", fallback="").strip()
        model = parser.get(role, "model", fallback="").strip()
        thinking = parser.get(role, "thinking", fallback="").strip()
        if provider != f"codex-{role}":
            raise SyncError(
                f"{path}: [{role}].provider must be codex-{role}, got {provider!r}"
            )
        if not model:
            raise SyncError(f"{path}: [{role}].model is required")
        if thinking not in {"medium", "max", "high"}:
            raise SyncError(
                f"{path}: [{role}].thinking must be medium, max, or high, got {thinking!r}"
            )
        contract[role] = {"provider": provider, "model": model, "thinking": thinking}
    return contract


def role_profile_path(codex_home: Path, repo_root: Path, role: str) -> Path:
    checked_in = repo_root / ".codex" / "agents" / f"{role}.toml"
    if checked_in.is_file():
        return checked_in
    return codex_home / f"{role}.config.toml"


def validate_profile(path: Path, expected_thinking: str) -> tuple[str, str]:
    profile = load_toml(path)
    reasoning = profile.get("model_reasoning_effort")
    instructions = profile.get("developer_instructions")
    if not isinstance(reasoning, str) or not reasoning.strip():
        raise SyncError(f"{path}: model_reasoning_effort is required")
    if reasoning.strip() != expected_thinking:
        raise SyncError(
            f"{path}: model_reasoning_effort {reasoning!r} does not match config.model thinking {expected_thinking!r}"
        )
    if not isinstance(instructions, str) or not instructions.strip():
        raise SyncError(f"{path}: developer_instructions is required")
    if '"""' in instructions:
        raise SyncError(f"{path}: developer_instructions contains an unsafe triple quote")
    return reasoning.strip(), instructions


def strip_top_level_assignments(text: str) -> str:
    lines = text.splitlines(keepends=True)
    output: list[str] = []
    current_table = False
    skipping_multiline = False
    for line in lines:
        stripped = line.strip()
        if skipping_multiline:
            if '"""' in line:
                skipping_multiline = False
            continue
        if stripped.startswith("[") and stripped.endswith("]"):
            current_table = True
        if not current_table:
            match = TOP_LEVEL_ASSIGNMENT.match(line)
            if match:
                if match.group(1) == "developer_instructions" and '"""' in line and line.count('"""') == 1:
                    skipping_multiline = True
                continue
        output.append(line)
    if skipping_multiline:
        raise SyncError("baseline config has an unclosed developer_instructions string")
    return "".join(output)


def project_code_home(text: str, runtime: Path) -> str:
    replacement = json.dumps(str(runtime))
    return "\n".join(
        CODEX_HOME_ASSIGNMENT.sub(rf"\g<1>{replacement}", line)
        for line in text.split("\n")
    )


def project_config(
    baseline: str,
    model: str,
    thinking: str,
    instructions: str,
    runtime: Path,
) -> str:
    body = strip_top_level_assignments(baseline)
    body = project_code_home(body, runtime)
    first_table = re.search(r"(?m)^\s*\[", body)
    prefix = (
        f"model = {json.dumps(model)}\n"
        f"model_reasoning_effort = {json.dumps(thinking)}\n\n"
        "developer_instructions = \"\"\"\n"
        f"{instructions.rstrip()}\n"
        "\"\"\"\n\n"
    )
    if first_table:
        index = first_table.start()
        projected = body[:index] + prefix + body[index:]
    else:
        projected = prefix + body
    try:
        parsed = tomllib.loads(projected)
    except tomllib.TOMLDecodeError as error:
        raise SyncError(f"projected config is invalid TOML: {error}") from error
    if parsed.get("model") != model or parsed.get("model_reasoning_effort") != thinking:
        raise SyncError("projected config did not retain the requested model/reasoning tuple")
    return projected


def ensure_shared_targets(codex_home: Path) -> None:
    for name in SHARED_ENTRIES:
        target = codex_home / name
        if not target.exists() and not target.is_symlink():
            raise SyncError(f"missing shared Codex target: {target}")


def validate_link_paths(runtime_root: Path, roles: tuple[str, ...]) -> None:
    if runtime_root.exists() and not runtime_root.is_dir():
        raise SyncError(f"runtime root is not a directory: {runtime_root}")
    for role in roles:
        runtime = runtime_root / role
        if runtime.exists() and not runtime.is_dir():
            raise SyncError(f"role runtime is not a directory: {runtime}")
        if runtime.is_symlink():
            raise SyncError(f"role runtime must not be a symlink: {runtime}")
        for name in SHARED_ENTRIES:
            link = runtime / name
            if link.exists() and not link.is_symlink():
                raise SyncError(f"refusing to replace real runtime entry: {link}")


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except OSError as error:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise SyncError(f"cannot write {path}: {error.strerror or error}") from error


def sync(repo_root: Path, codex_home: Path, runtime_root: Path) -> list[str]:
    repo_root = expand(repo_root)
    codex_home = expand(codex_home)
    runtime_root = expand(runtime_root)
    contract = load_role_contract(repo_root)
    baseline_path = codex_home / "config.toml"
    baseline = read_text(baseline_path)
    load_toml(baseline_path)
    ensure_shared_targets(codex_home)
    validate_link_paths(runtime_root, ROLES)

    projected: dict[str, str] = {}
    profile_paths: dict[str, Path] = {}
    for role in ROLES:
        profile_path = role_profile_path(codex_home, repo_root, role)
        profile_paths[role] = profile_path
        _, instructions = validate_profile(profile_path, contract[role]["thinking"])
        projected[role] = project_config(
            baseline,
            contract[role]["model"],
            contract[role]["thinking"],
            instructions,
            runtime_root / role,
        )

    runtime_root.mkdir(parents=True, exist_ok=True)
    for role in ROLES:
        runtime = runtime_root / role
        runtime.mkdir(parents=True, exist_ok=True)
        atomic_write(runtime / "config.toml", projected[role])
        for name in SHARED_ENTRIES:
            link = runtime / name
            if link.is_symlink():
                link.unlink()
            link.symlink_to(codex_home / name)
    return [f"{role}: {profile_paths[role]} -> {runtime_root / role}" for role in ROLES]


def main() -> int:
    args = parse_args()
    try:
        for summary in sync(args.repo_root, args.codex_home, args.runtime_root):
            print(f"SYNC {summary}")
    except SyncError as error:
        print(f"codex-room-sync: {error}", file=os.sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
