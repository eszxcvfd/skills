#!/bin/sh
set -eu

role=${1:-}
case "$role" in
  supervisor|root|peer) ;;
  *)
    echo "usage: codex-room <supervisor|root|peer> <codex arguments...>" >&2
    exit 64
    ;;
esac

runtime_root=${CODEX_RUNTIME_ROOT:-"${HOME}/.codex-runtime"}
runtime="${runtime_root}/${role}"
if [ ! -f "${runtime}/config.toml" ]; then
  echo "codex-room: missing synced runtime ${runtime}/config.toml; run codex-room-sync first" >&2
  exit 1
fi

if [ -n "${CODEX_BIN:-}" ]; then
  codex_bin=${CODEX_BIN}
else
  codex_bin=$(command -v codex || true)
fi
if [ -z "${codex_bin}" ] || [ ! -x "${codex_bin}" ]; then
  echo "codex-room: executable codex was not found; set CODEX_BIN" >&2
  exit 1
fi

case "${codex_bin}" in
  "$0"|*/codex-room)
    echo "codex-room: CODEX_BIN resolves to the Paseo wrapper" >&2
    exit 1
    ;;
esac

export CODEX_HOME="${runtime}"
shift
exec "${codex_bin}" "$@"
