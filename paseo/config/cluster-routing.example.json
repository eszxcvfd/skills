{
  "$comment": "Controller-local input. Copy to ~/.paseo-pi-team/cluster-routing.local.json. Endpoint values stay in environment variables.",
  "version": 1,
  "hosts": {
    "primary": {
      "connection": { "type": "local" },
      "required": true,
      "capabilities": ["git-read", "git-write", "focused-test"],
      "limits": { "writers": 1, "readers": 3 },
      "routes": {
        "MONITOR_ECONOMY": { "paseoProvider": "pi-supervisor", "model": "<pi-provider>/<model-id>", "thinking": "low" },
        "FAST_READ": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "low" },
        "CODING_MEDIUM": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "medium" },
        "REASONING_HIGH": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "high" },
        "REVIEW_HIGH": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "high" }
      }
    },
    "reviewer": {
      "connection": { "type": "remote", "endpointEnv": "PASEO_REVIEW_ENDPOINT" },
      "required": false,
      "capabilities": ["git-read", "focused-test", "independent-review"],
      "limits": { "writers": 0, "readers": 2 },
      "routes": {
        "MONITOR_ECONOMY": { "paseoProvider": "pi-supervisor", "model": "<pi-provider>/<model-id>", "thinking": "low" },
        "FAST_READ": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "low" },
        "CODING_MEDIUM": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "medium" },
        "REASONING_HIGH": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "high" },
        "REVIEW_HIGH": { "paseoProvider": "pi-peer", "model": "<pi-provider>/<model-id>", "thinking": "high" }
      }
    }
  }
}
