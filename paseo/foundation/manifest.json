{
  "schemaVersion": 1,
  "kind": "paseo-foundation-role-bundle",
  "source": {
    "repository": "https://github.com/webplode/paseo-doctrine-downstream",
    "ref": "foundation-v0.1.0-dev.8",
    "mode": "downstream-contract-only"
  },
  "roleBundles": {
    "lead": {
      "active": [],
      "explicitOnly": ["repo-refresh"],
      "packagedDisabled": ["ultra-review"]
    },
    "peer": {
      "active": ["frontend-design"],
      "explicitOnly": [],
      "packagedDisabled": []
    },
    "supervisor": {
      "active": ["paseo-supervisor", "architecture-premise-audit", "test-proof-debt-audit"],
      "explicitOnly": [],
      "packagedDisabled": []
    }
  },
  "projection": {
    "providerAdaptersAreTransportOnly": true,
    "leaseAndBriefRequired": true,
    "invalidManifest": "fail-closed",
    "staticSkillPresenceGrantsAuthority": false
  }
}
